# ================================
# GuardianBot V1 - Environment Config
# ================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Bot Owner Telegram ID
OWNER_ID=123456789

# ================================
# Database (PostgreSQL)
# ================================
DATABASE_URL=postgresql://guardian:password@localhost:5432/guardianbot

# ================================
# Redis (Cache & Rate Limiting)
# ================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ================================
# App Settings
# ================================
NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=./logs

# ================================
# Bot Behavior
# ================================
# Default warn limit before punishment
DEFAULT_WARN_LIMIT=3

# Default mute duration (minutes)
DEFAULT_MUTE_DURATION=60

# Rate limit: messages per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=10000

# New user restrict duration (seconds)
NEW_USER_RESTRICT_DURATION=300

# ================================
# Optional: Webhook (production)
# ================================
# WEBHOOK_URL=https://yourdomain.com
# WEBHOOK_PORT=3000
# WEBHOOK_SECRET=your_webhook_secret
